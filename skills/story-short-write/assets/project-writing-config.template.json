{
  "version": "1.0",
  "project_name": "",
  "profile_path": "../profiles/{project_name}.project.profile.json",
  "length_policy": {
    "mode": "source_anchored",
    "min_total_ratio": 0.90,
    "min_section_ratio": 0.90,
    "max_total_ratio": 1.25,
    "max_section_ratio": 1.25
  },
  "distillation_policy": {
    "enabled": false,
    "model_env": "STORY_SHORT_WRITE_DISTILLATION_MODEL",
    "default_model": "gpt-6-astra",
    "passes": ["source_sentence_distillation", "anti_synopsis_review", "spoken_dialogue_review"],
    "temperature": 0.2
  },
  "beat_transfer_policy": {
    "mode": "functional_beat_transfer",
    "preserve_p_beat_order": true,
    "preserve_e_beat_order": true,
    "preserve_one_to_one_mapping": true,
    "preserve_emotion_function": true,
    "preserve_emotion_proposition": false
  },
  "primary": {
    "name": "",
    "profile_path": "",
    "original_path": "",
    "source_prose_map_path": "",
    "emotion_ledger_path": "",
    "plot_ledger_path": "",
    "role": "primary_full_plot_and_emotion",
    "prose_voice": "exclusive",
    "emotion_transfer_policy": "primary_functional_emotion"
  },
  "auxiliaries": []
}
